# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets — NEVER commit these (they contain DATABASE_URL etc.)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Stray archives / build zips
*.zip

# Old duplicate snapshot (has its own .git history — kept out of this repo)
3Q-Dashbaord/

# graphify — commit graph.json / GRAPH_REPORT.md, but never the local SHA256 cache
.graphify/cache/

# Superseded graphify output dir (.graphify/GRAPH_REPORT.md is the live report) and the
# refactor's head-comparison snapshot — both generated, both regenerable, neither shipped.
graphify-out/
.verify-head/

# Claude Code local settings (machine-specific)
.claude/settings.local.json
